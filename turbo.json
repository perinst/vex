{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalDependencies": [
    "patches/**",
    "bunfig.toml",
    ".npmrc",
    ".github/actions/setup-bun/**",
    ".github/workflows/test.yml"
  ],
  "globalEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "@vex/cli#typecheck": {
      "dependsOn": ["@vex/core#typecheck"]
    },
    "test:components": {
      "outputs": [],
      "cache": false
    },
    "@vex/enterprise#typecheck": {
      "dependsOn": ["@vex/core#typecheck"]
    },
    "@vex/sdk#typecheck": {
      "dependsOn": ["@vex/core#typecheck"]
    },
    "@vex/server#typecheck": {
      "dependsOn": ["@vex/core#typecheck"]
    },
    "@vex/simulation#typecheck": {
      "dependsOn": ["@vex/core#typecheck"]
    },
    "@vex/tui#typecheck": {
      "dependsOn": ["@vex/core#typecheck"]
    },
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "@vex/ai#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@vex/codemode#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@vex/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@vex/function#test": {
      "outputs": []
    },
    "@vex/desktop#test": {
      "outputs": [],
      "cache": false
    },
    "@vex/httpapi-codegen#test": {
      "outputs": []
    },
    "@vex/server#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@vex/cli#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@vex/tui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@vex/latex#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@vex/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@vex/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@vex/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@vex/sdk#verify:package": {
      "outputs": []
    }
  }
}
